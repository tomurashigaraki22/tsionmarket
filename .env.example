NODE_ENV=development
HOST=0.0.0.0
PORT=3030
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
JSON_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_BYPASS_ENABLED=false
AUTH_ACCESS_TOKEN_SECRET=development-access-token-secret-change-me
AUTH_ACCESS_TOKEN_KID=primary
AUTH_TOKEN_ISSUER=tsionmarket-backend
AUTH_TOKEN_AUDIENCE=tsionmarket-client
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_PEPPER=development-refresh-token-pepper-change-me
AUTH_PASSWORD_PEPPER=development-password-pepper-change-me
AUTH_CHALLENGE_PEPPER=development-challenge-pepper-change-me
AUTH_REFRESH_IDLE_TTL_SECONDS=2592000
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=7776000
AUTH_VERIFICATION_TTL_SECONDS=3600
AUTH_RESET_TTL_SECONDS=1800
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOCKOUT_SECONDS=900
AUTH_CLEANUP_INTERVAL_SECONDS=3600
AUTH_TERMS_VERSION=2026-09-22
AUTH_COOKIE_NAME=tsion_refresh
AUTH_CSRF_COOKIE_NAME=tsion_csrf
AUTH_EMAIL_DELIVERY_MODE=console
# Set to smtp (Hostinger) or http outside local development.
# Port 465 is implicit TLS; use 587 with AUTH_SMTP_SECURE=false for STARTTLS.
AUTH_SMTP_HOST=smtp.hostinger.com
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=TsionMarket <no-reply@tsionmarket.com>
AUTH_EMAIL_LINK_BASE_URL=http://localhost:3000

# Same provider-key contract as dashboard-revamp/worldstreet-crypto-backend.
# Comma-separated *_RPC_URLS are tried in order with cooldown/failover.
NETWORK_MODE=development
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_FALLBACK_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_FALLBACK_RPC_URL=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_FALLBACK_RPC_URL=
ETHEREUM_RPC_URLS=
ETHEREUM_RPC_URL=
ETHEREUM_FALLBACK_RPC_URL=
ARBITRUM_RPC_URLS=
ARBITRUM_RPC_URL=
ARBITRUM_FALLBACK_RPC_URL=
SOLANA_MAINNET_RPC_URLS=
SOLANA_MAINNET_RPC_URL=
RPC_TIMEOUT_MS=8000
RPC_MAX_RETRIES=1
RPC_PROVIDER_COOLDOWN_MS=30000
BALANCE_CACHE_TTL_MS=15000
BALANCE_AGGREGATE_TIMEOUT_MS=12000
BALANCE_MAX_CONCURRENCY=5
SPOT_MARKET_REGISTRY_ENABLED=false
SPOT_MARKET_REGISTRY_START_DELAY_SECONDS=15
SPOT_MARKET_REGISTRY_INTERVAL_SECONDS=900
SPOT_MARKET_REGISTRY_MAX_TOKENS_PER_ROUTE=500
MARKET_STALE_AFTER_SECONDS=1800
LIFI_API_URL=https://li.quest/v1
LIFI_API_KEY=
LIFI_INTEGRATOR=tewa
LIFI_QUOTE_TIMEOUT_MS=15000
SWAP_QUOTE_TTL_SECONDS=60
TRANSACTION_INTENT_TTL_SECONDS=300
MAX_SLIPPAGE_BPS=500
FEE_SAFETY_BUFFER_BPS=2000
SUBMISSION_MAX_BYTES=200000
TRANSACTION_RECONCILE_INTERVAL_SECONDS=30
TRANSACTION_RECONCILE_BATCH_SIZE=100
TRANSACTION_RECONCILE_MAX_ATTEMPTS=20
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tsionmarket
MYSQL_USER=tsionmarket_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_ACQUIRE_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=10000

MYSQL_MIGRATION_USER=tsionmarket_migrator
MYSQL_MIGRATION_PASSWORD=replace-with-a-separate-long-random-password
MYSQL_MIGRATION_LOCK_TIMEOUT_SECONDS=30
