# Automatic Let's Encrypt TLS for api.tsionmarket.com.
# Caddy obtains and renews the certificate on its own once the DNS A record
# points at this server and ports 80/443 are reachable.

{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# gzip buffers output before flushing, which would delay SSE events behind
	# the compressor's buffer instead of delivering them as they're written.
	# The transaction stream is excluded so it reaches the browser immediately.
	@notstream {
		not path /v1/transactions/stream
	}
	encode @notstream zstd gzip

	# The API sets its own security headers via helmet; add HSTS at the edge.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Keep the metrics endpoint off the public internet.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy api:3456 {
		health_uri /health
		health_interval 10s
		health_timeout 5s

		# Flush every write immediately rather than batching — required for the
		# SSE stream to deliver events as they happen, not once a buffer fills.
		flush_interval -1

		# The API trusts exactly one proxy hop (TRUST_PROXY_HOPS=1) and reads
		# the client IP from these headers.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
